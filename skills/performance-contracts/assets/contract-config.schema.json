{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/napetrov/skills/schemas/contract-config.schema.json",
  "title": "Contract Configuration",
  "description": "Project-owned configuration in .petrov/contracts/config.json. Commands are argument arrays; no shell strings.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_dir", "commands", "scopes"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_dir": {"type": "string", "description": "Relative directory for ignored run artifacts."},
    "diff_base_policy": {"type": "string"},
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "argv", "timeout_seconds"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "cwd": {"type": "string"},
          "timeout_seconds": {"type": "number", "exclusiveMinimum": 0},
          "output_file": {"type": "string", "description": "Relative to the run directory; substituted for {output}."}
        }
      }
    },
    "scopes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "paths"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    }
  }
}
