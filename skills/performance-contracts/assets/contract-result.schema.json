{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/napetrov/skills/schemas/contract-result.schema.json",
  "title": "Contract Result Envelope",
  "description": "Versioned result envelope shared by performance-contracts and verify-user-outcomes. Major version 1 is supported.",
  "type": "object",
  "required": [
    "schema_version", "run_id", "started_at", "finished_at", "skill", "mode", "scope_ids", "contract_ids",
    "repository", "baseline", "execution", "observations", "findings", "coverage", "results", "verdict", "limitations"
  ],
  "properties": {
    "schema_version": {"type": "string", "pattern": "^1\\.[0-9]+$"},
    "run_id": {"type": "string", "minLength": 1},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "skill": {"type": "string", "enum": ["performance-contracts", "verify-user-outcomes"]},
    "mode": {"type": "string", "enum": ["setup", "check", "improve", "maintain"]},
    "scope_ids": {"type": "array", "items": {"type": "string"}},
    "contract_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "repository": {
      "type": "object",
      "required": ["commit", "dirty", "content_digest", "diff_base"],
      "properties": {
        "commit": {"type": ["string", "null"]},
        "dirty": {"type": ["boolean", "null"]},
        "content_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
        "diff_base": {
          "type": "object",
          "required": ["method", "base"],
          "properties": {
            "method": {"type": "string", "enum": ["explicit-base", "pr-merge-base", "working-tree-vs-head", "unavailable"]},
            "base": {"type": ["string", "null"]}
          }
        }
      }
    },
    "baseline": {"type": "object", "description": "Baseline references, digests and environment fingerprint."},
    "execution": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["command_id", "argv", "status", "timed_out", "duration_ms"],
            "properties": {
              "command_id": {"type": "string"},
              "argv": {"type": "array", "items": {"type": "string"}},
              "status": {"type": ["integer", "null"], "description": "Raw child exit code; null when not started or killed."},
              "timed_out": {"type": "boolean"},
              "duration_ms": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "observations": {"type": "array", "description": "Per-contract summaries; raw measurements live in run artifacts."},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "severity", "evidence_label"],
        "properties": {
          "category": {
            "type": "string",
            "enum": [
              "correctness_violation", "budget_violation", "execution_error", "uncovered_scope",
              "not_configured", "promised_but_missing", "unreachable_result", "behavior_mismatch",
              "stale_mapping", "unverified_scope", "unexplained_implementation"
            ]
          },
          "severity": {"type": "string", "enum": ["high", "medium", "low", "info"]},
          "evidence_label": {"type": "string", "enum": ["observed", "inferred", "unverified"]}
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": ["requested", "selected", "executed", "passed", "failed", "unverified"],
      "properties": {
        "requested": {"type": "array", "items": {"type": "string"}},
        "selected": {"type": "array", "items": {"type": "string"}},
        "executed": {"type": "array", "items": {"type": "string"}},
        "passed": {"type": "array", "items": {"type": "string"}},
        "failed": {"type": "array", "items": {"type": "string"}},
        "unverified": {"type": "array", "items": {"type": "string"}}
      }
    },
    "results": {
      "type": "array",
      "description": "Exactly one terminal result per selected contract.",
      "items": {
        "type": "object",
        "required": ["contract_id", "verdict", "reason"],
        "properties": {
          "contract_id": {"type": "string"},
          "verdict": {"type": "string", "enum": ["pass", "fail", "inconclusive", "error", "not_applicable"]},
          "reason": {"type": "string"}
        }
      }
    },
    "verdict": {"type": "string", "enum": ["pass", "fail", "inconclusive", "error", "not_applicable"]},
    "limitations": {"type": "array", "items": {"type": "string"}}
  }
}
