{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/napetrov/skills/schemas/outcome-contract.schema.json",
  "title": "Outcome Contract",
  "description": "A promised user or consumer outcome linked to intent, implementation and stable test evidence ids.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "scope", "actor", "entry_point", "result", "acceptance", "intent_refs", "implementation_refs", "evidence_ids", "command_id", "performance_contract_ids", "criticality"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "status": {"enum": ["proposed", "enabled"]},
    "scope": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "actor": {"type": "string", "minLength": 1},
    "entry_point": {"type": "string", "minLength": 1},
    "preconditions": {"type": "array", "items": {"type": "string"}},
    "result": {"type": "string", "minLength": 1},
    "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "negative_behavior": {"type": "array", "items": {"type": "string"}},
    "intent_refs": {"type": "array", "items": {"type": "string"}, "description": "Repository paths, optionally with #anchor. Enabled contracts need at least one."},
    "implementation_refs": {"type": "array", "items": {"type": "string"}},
    "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, "uniqueItems": true},
    "command_id": {"type": "string"},
    "performance_contract_ids": {"type": "array", "items": {"type": "string"}},
    "criticality": {"enum": ["high", "medium", "low"]}
  }
}
