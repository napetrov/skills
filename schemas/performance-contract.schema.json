{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/napetrov/skills/schemas/performance-contract.schema.json",
  "title": "Performance Contract",
  "description": "Declarative budget over named workload dimensions. No expression language; eval is never used.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "status", "scope", "operation", "paths", "command_id", "oracle_id", "workload", "assertions", "profile", "baseline_ref"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)+$"},
    "status": {"enum": ["proposed", "enabled"]},
    "scope": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "operation": {"type": "string", "minLength": 1},
    "paths": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "command_id": {"type": "string"},
    "oracle_id": {"type": "string"},
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "sizes", "cache_state"],
      "properties": {
        "dimension": {"type": "string"},
        "sizes": {"type": "array", "minItems": 2, "items": {"type": "integer", "minimum": 1}, "uniqueItems": true},
        "fixed": {"type": "object"},
        "cache_state": {"enum": ["cold", "warm", "invalidated", "none"]}
      }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["metric", "operator", "value"],
            "additionalProperties": false,
            "properties": {"metric": {"type": "string"}, "operator": {"const": "eq"}, "value": {}, "negative_control": {"$ref": "#/$defs/negative_control"}}
          },
          {
            "type": "object",
            "required": ["metric", "operator", "coefficient", "shape", "dimension"],
            "additionalProperties": false,
            "properties": {
              "metric": {"type": "string"},
              "operator": {"const": "le"},
              "coefficient": {"type": "number", "exclusiveMinimum": 0},
              "shape": {"enum": ["constant", "linear", "n_log_n", "quadratic"], "description": "constant: the bound is coefficient at every size. Use it for counts that do not grow with the workload, such as iterations or kernel calls."},
              "dimension": {"type": "string"},
              "negative_control": {"$ref": "#/$defs/negative_control"}
            }
          }
        ]
      }
    },
    "profile": {"enum": ["pr", "scheduled", "manual"]},
    "baseline_ref": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*-v[0-9]+$", "description": "Immutable versioned manifest name. 'latest' is not allowed."}
  },
  "$defs": {
    "negative_control": {
      "type": "object",
      "description": "A deliberate change applied to a disposable copy of the repository. The target metric must violate its assertion, or the gate is blind to it. Required on every assertion of an enabled contract.",
      "additionalProperties": false,
      "required": ["kind", "file", "before", "after"],
      "properties": {
        "kind": {"enum": ["synthetic", "regression"], "description": "synthetic: only the counter or its accounting changes, so it proves the counter is wired, not that it catches a real regression. regression: a behavioral change in product code."},
        "file": {"type": "string", "description": "Repository-relative path to the file the change is applied to."},
        "before": {"type": "string", "minLength": 1, "description": "Exact text that must occur exactly once in file."},
        "after": {"type": "string", "description": "Replacement text. Empty deletes the matched text."}
      }
    }
  }
}
