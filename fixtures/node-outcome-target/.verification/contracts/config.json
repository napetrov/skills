{
  "schema_version": "1.0",
  "artifact_dir": ".artifacts/contracts",
  "diff_base_policy": "explicit-or-pr-merge-base-or-head",
  "commands": [
    {
      "id": "test-scan-compare",
      "argv": ["node", "--test", "--test-reporter=tap", "tests/scan-compare.test.js"],
      "cwd": ".",
      "timeout_seconds": 120
    }
  ],
  "scopes": [
    {
      "id": "scan-compare-cli",
      "paths": ["src/**", "tests/**", "data/**", "docs/**"]
    }
  ]
}
