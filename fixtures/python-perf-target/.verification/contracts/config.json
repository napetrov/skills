{
  "schema_version": "1.0",
  "artifact_dir": ".artifacts/contracts",
  "diff_base_policy": "explicit-or-pr-merge-base-or-head",
  "commands": [
    {
      "id": "bench-symbol-match",
      "argv": ["python3", "benchmarks/contracts/bench_symbol_match.py", "--output", "{output}"],
      "cwd": ".",
      "timeout_seconds": 120,
      "output_file": "bench-symbol-match.json"
    }
  ],
  "scopes": [
    {
      "id": "fixture-symbol-matcher",
      "paths": ["src/**", "benchmarks/contracts/**", "tests/contracts/**"]
    }
  ]
}
